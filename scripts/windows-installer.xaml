<!-- The OmniAgent Core installer window. windows-installer.cs loads this and switches its states. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniAgent Core" Width="520" Height="440"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#070B16"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <LinearGradientBrush x:Key="Brand" StartPoint="0,0.2" EndPoint="1,0.8">
      <GradientStop Color="#0B5CFF" Offset="0"/>
      <GradientStop Color="#2F9BFF" Offset="0.48"/>
      <GradientStop Color="#46D1FF" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Height" Value="56"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" CornerRadius="28" Background="{StaticResource Brand}" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform/>
              </Border.RenderTransform>
              <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="9" Direction="270" Color="#0B5CFF" Opacity="0.34"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.985" ScaleY="0.96"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Close" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" CornerRadius="17" Background="#EEF2F9">
              <TextBlock Text="&#xD7;" FontSize="20" Foreground="#5F6984" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#E6EBF5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tick" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#5F6984"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="#CBD4E6" Background="White" VerticalAlignment="Center">
                <TextBlock x:Name="Mark" Text="&#x2713;" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#0B5CFF"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#0B5CFF"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Margin="30">
    <Border x:Name="Card" CornerRadius="28" Background="White" BorderBrush="#DFE5F1" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="36" ShadowDepth="12" Direction="270" Color="#0B2878" Opacity="0.24"/>
      </Border.Effect>
    </Border>

    <Button x:Name="CloseButton" Style="{StaticResource Close}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" ToolTip="Close"/>

    <StackPanel Margin="46,0" VerticalAlignment="Center">
      <Image x:Name="Logo" Width="82" Height="82" HorizontalAlignment="Center"/>
      <TextBlock x:Name="Heading" Text="OmniAgent Core" FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
      <TextBlock x:Name="Subtitle" Text="ChatGPT and Claude on the same team." FontSize="14.5" Foreground="#5F6984" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="40"/>

      <Grid Height="104" Margin="0,8,0,0">
        <StackPanel x:Name="Choice" VerticalAlignment="Center">
          <CheckBox x:Name="DeleteData" Style="{StaticResource Tick}" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed" Content="Also delete my settings, chats and saved logins"/>
          <Button x:Name="Action" Style="{StaticResource Primary}" Content="Install" IsDefault="True"/>
        </StackPanel>

        <StackPanel x:Name="Working" VerticalAlignment="Center" Visibility="Collapsed">
          <Grid x:Name="Track" Height="10">
            <Border CornerRadius="5" Background="#EEF2F9"/>
            <Rectangle x:Name="Fill" Width="10" RadiusX="5" RadiusY="5" HorizontalAlignment="Left">
              <Rectangle.Fill>
                <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="260,0" SpreadMethod="Repeat">
                  <GradientStop Color="#0B5CFF" Offset="0"/>
                  <GradientStop Color="#46D1FF" Offset="0.5"/>
                  <GradientStop Color="#0B5CFF" Offset="1"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
          </Grid>
          <Grid Margin="0,12,0,0">
            <TextBlock x:Name="Status" FontSize="13.5" Foreground="#5F6984" TextTrimming="CharacterEllipsis" Margin="0,0,52,0"/>
            <TextBlock x:Name="Percent" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          </Grid>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
